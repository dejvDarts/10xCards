---
import FlashcardList from "@/components/FlashcardList";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listFlashcards } from "@/lib/services/flashcards";
import type { ListFlashcardsResponse } from "@/types";

// middleware.ts guards PROTECTED_ROUTES (this route included), so `user` is
// always set here — the `if (user)` below only satisfies the type narrowing.
const { user } = Astro.locals;

let initialData: ListFlashcardsResponse | null = null;
let initialError: string | undefined;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  initialError = "Supabase is not configured";
} else if (user) {
  try {
    initialData = await listFlashcards(supabase, user.id, 1);
  } catch {
    initialError = "Failed to load flashcards";
  }
}
---

<Layout title="Your flashcards">
  <main class="bg-cosmic min-h-screen px-4 py-12 text-white sm:py-16">
    <div class="mx-auto max-w-5xl">
      <p class="mb-3 text-sm font-medium text-blue-200">Personal collection</p>
      <h1 class="text-3xl font-bold sm:text-4xl">Your saved flashcards.</h1>
      <p class="mt-3 max-w-2xl text-blue-100/75">Browse the flashcards you've accepted into your collection.</p>
      <div class="mt-8">
        <FlashcardList client:load initialData={initialData} initialError={initialError} />
      </div>
    </div>
  </main>
</Layout>
