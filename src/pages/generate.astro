---
import FlashcardGenerator from "@/components/FlashcardGenerator";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Generate flashcards">
  <main class="bg-cosmic min-h-screen px-4 py-12 text-white sm:py-16">
    <div class="mx-auto max-w-5xl">
      <p class="mb-3 text-sm font-medium text-blue-200">AI flashcard workshop</p>
      <h1 class="text-3xl font-bold sm:text-4xl">Turn source material into cards worth keeping.</h1>
      <p class="mt-3 max-w-2xl text-blue-100/75">
        Generate proposals from your notes, then refine each question and answer before accepting it.
      </p>
      <div class="mt-8">
        <FlashcardGenerator client:only="react" />
      </div>
    </div>
  </main>
</Layout>
